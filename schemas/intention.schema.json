{
  "type": "object",
  "properties": {
    "preference": {
      "type": "string",
      "enum": [
        "speak",
        "wait",
        "yield",
        "silent"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "contribute",
        "question",
        "correct",
        "warn",
        "respond",
        "invite",
        "listen"
      ]
    },
    "topic": {
      "type": "string",
      "maxLength": 160
    },
    "length": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ]
    },
    "tool": {
      "type": "string",
      "maxLength": 160,
      "description": "if you have tools and your turn needs a lookup: what you would run, one line; omit otherwise"
    }
  },
  "required": [
    "preference",
    "topic"
  ],
  "additionalProperties": true
}
