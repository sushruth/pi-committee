{
  "type": "object",
  "properties": {
    "preference": {
      "type": "string",
      "enum": [
        "speak",
        "wait",
        "deliberate",
        "yield",
        "silent"
      ]
    },
    "topic": {
      "type": "string",
      "maxLength": 80,
      "description": "a few words on your topic or vibe, never the answer; omit when holding"
    },
    "discovery": {
      "type": "boolean",
      "description": "true only for new evidence that needs more discussion"
    }
  },
  "required": [
    "preference"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "preference": "speak",
      "topic": "one missing constraint"
    }
  ]
}
